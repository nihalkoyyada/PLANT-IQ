# Database Configuration
DATABASE_URL=postgresql+psycopg://plantiq:<DB_PASSWORD>@localhost:5432/plantiq

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security & Authentication Configuration
SECRET_KEY=<YOUR_SECRET_KEY>
JWT_SECRET=<YOUR_JWT_SECRET>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application Settings & CORS
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Email Notification Delivery (Resend API - Recommended)
# 1. Sign up for free at https://resend.com (no custom domain or Google/Gmail account needed).
# 2. Go to API Keys -> Create API Key.
# 3. Paste your key below:
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_your_api_key_here

# For initial testing without a custom domain, use Resend's verified testing sender:
EMAIL_FROM=PlantIQ Alerts <onboarding@resend.dev>

# IMPORTANT PROVIDER RESTRICTION IN TESTING MODE:
# When using 'onboarding@resend.dev', Resend permits sending emails ONLY to the email
# address associated with your Resend account.
# When ready for production, verify a custom domain at https://resend.com/domains and
# update EMAIL_FROM (e.g. EMAIL_FROM=PlantIQ Alerts <alerts@yourcompany.com>).

# Set to true ONLY for offline mock testing without sending real emails:
MOCK_EMAIL=false

# Optional Legacy SMTP Configuration (Only used if configured with an external SMTP host; localhost is rejected)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# AI Copilot & LLM Provider Configuration (§10.2, Task S5-AI-01)
# Options: 'mock' (default offline development/tests), 'anthropic', 'openai_compatible', 'vllm'
LLM_PROVIDER=mock
LLM_MODEL=mock-copilot-v1
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=
# MOCK_SIMULATE_ERROR=  # Optional error simulation: 'rate_limit', 'auth', 'timeout', 'service_unavailable'

